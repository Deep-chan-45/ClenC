# GEMINI_API_KEY: Required for Gemini AI API calls (Bin Classifier, Vision Inspector, Waste Scanner).
# When deploying to Vercel, add GEMINI_API_KEY to your Vercel Project Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional client-side mirror variable for Vercel / Vite
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
